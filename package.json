{
  "name": "@innovixx/payload-color-picker-field",
  "version": "2.0.2",
  "homepage:": "https://innovixx.co.uk",
  "repository": "git@github.com:Innovixx-Development/payload-color-picker-field.git",
  "description": "The Payload Color Picker that enables an easy color selection field for your Payload projects.",
  "type": "module",
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "lint": "eslint src",
    "lint:fix": "eslint --fix --ext .ts,.tsx src",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "nodemon --watch src -e ts,tsx,scss --exec \"pnpm build\""
  },
  "keywords": [
    "payload",
    "cms",
    "field",
    "plugin",
    "typescript",
    "react",
    "color",
    "picker"
  ],
  "author": "support@innovixx.co.uk",
  "license": "MIT",
  "peerDependencies": {
    "next": "^15.0.0",
    "payload": "^3.2.2",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/eslint-config": "^3.28.0",
    "@payloadcms/eslint-plugin": "^3.28.0",
    "@payloadcms/next": "^3.58.0",
    "@payloadcms/translations": "^3.58.0",
    "@payloadcms/ui": "^3.58.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/node": "^20.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "next": "^15.5.4",
    "nodemon": "^2.0.22",
    "payload": "^3.58.0",
    "prettier": "^2.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "ts-essentials": "^10.1.1",
    "ts-node": "^9.1.1",
    "typescript": "~5.7.3"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    }
  },
  "dependencies": {
    "react-colorful": "^5.6.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
